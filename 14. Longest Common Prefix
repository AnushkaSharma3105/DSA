class Solution {
    public String longestCommonPrefix(String[] strs) {

        Arrays.sort(strs);
        int n = strs.length;
        String first = strs[0];
        String last = strs[n-1];
        int idx = 0;

        while(idx < first.length() && idx < last.length()){
            if(first.charAt(idx) == last.charAt(idx)){
                idx++;
            }
            else break;
        }
        
        return first.substring(0, idx);
    }
}
